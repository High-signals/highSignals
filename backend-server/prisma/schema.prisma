generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PROVIDER {
  LOCAL
  GOOGLE
  FACEBOOK
  TWITTER
}

enum ICPType {
  BUSINESS
  CREATOR
}

enum PLATFORM {
  TWITTER
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum POST_STATUS {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  IDEA
  SCRIPTING
  RECORDING
  EDITING
  POSTED
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  name                 String
  password             String?
  provider             PROVIDER[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  googleId             String?            @unique
  refreshToken         String?            @unique
  avatar               String?
  bio                  String?
  passwordResetExpires DateTime?
  passwordResetToken   String?            @unique
  icp                  ICP?
  otp                  Otp?
  posts                Post[]
  connectedAccounts    connectedAccount[]
}

model Otp {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ICP {
  id             String   @id @default(uuid())
  userId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  additional     String?
  backstory      String?
  contentTopic   String?
  demographics   String?
  desiredOutcome String?
  goal           String?
  type           ICPType
  audience       String
  problem        String?
  profession     String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model connectedAccount {
  id          String   @id @default(uuid())
  userId      String
  twitterId   String?  @unique
  facebookId  String?  @unique
  linkedInId  String?  @unique
  tiktokId    String?  @unique
  instagramId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id              String      @id @default(uuid())
  userId          String
  title           String?
  content         String
  mediaUrls       String[]
  platformContent Json?
  externalPostIds Json?
  contentType     String?
  status          POST_STATUS @default(IDEA)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  isDeleted       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  platforms       PLATFORM[]
  user            User        @relation(fields: [userId], references: [id])
}


