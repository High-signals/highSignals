# ---- Core ----
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Auth (JWT) ----
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
JWT_EXPIRES_IN=7d

# ---- Supabase (avatar / media storage) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AVATARS_BUCKET=avatars

# ---- Google Cloud Speech-to-Text + Storage ----
# The FULL contents of the service-account JSON key, on a single line (stringified).
# Service account needs roles: "Cloud Speech Client" and "Storage Object Admin".
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GCS bucket for long (> ~55s) audio transcription (async longRunningRecognize).
GCS_BUCKET_NAME=your-voice-audio-bucket
